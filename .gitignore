# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Firebase Configuration (contains API keys)
src/config/firebase.ts

# Android specific
android/app/google-services.json
android/app/release/
android/app/debug/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
*.apk
*.aab
*.ap_
*.dex
*.class

# iOS specific
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/App/*.xcworkspace
*.ipa
*.dSYM.zip
*.dSYM

# Capacitor
capacitor.config.json
.capacitor/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
/cypress/videos/
/cypress/screenshots/

# IDE
*.swp
*.swo
*~
.project
.classpath
.settings/
.loadpath
.externalToolBuilders/
*.launch

# Misc
*.iml
.gradle
build/
gradle-app.setting
.gradletasknamecache
